{
  "name": "monkey-agent",
  "version": "0.2.0",
  "description": "The AI coding assistant that evolves",
  "type": "module",
  "bin": {
    "monkey": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --loader ts-node/esm --no-warnings src/index.ts",
    "build": "tsc && node scripts/postbuild.mjs",
    "start": "node dist/index.js",
    "test": "tsc && node --experimental-transform-types --test tests/*.test.mjs",
    "serve": "node dist/index.js serve",
    "client:install": "npm ci --prefix apps/universal",
    "client:web": "npm run web --prefix apps/universal",
    "client:export": "npm run export --prefix apps/universal"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.4.1",
    "glob": "^11.0.0",
    "openai": "^6.45.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
